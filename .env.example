# RAG runtime mode: mock, local, local_llm, or azure
# local_llm searches local Markdown and generates grounded answers with Ollama.
RAG_MODE=local_llm
KNOWLEDGE_DIR=docs/knowledge-finance

# Ollama (required only when RAG_MODE=local_llm)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b-it-qat
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_CONTEXT_LENGTH=2048
OLLAMA_TEMPERATURE=0
OLLAMA_MAX_TOKENS=160
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_CHUNKS=2
OLLAMA_CONTEXT_SCORE_RATIO=0.90
OLLAMA_MAX_CHUNK_CHARS=1000
OLLAMA_NUM_THREADS=4
OLLAMA_NUM_BATCH=256

# Governed local conversation memory
MEMORY_ENABLED=true
MEMORY_DB_PATH=output/memory/conversation-memory.sqlite3
MEMORY_PREFERENCE_TTL_DAYS=90
MEMORY_FACT_TTL_DAYS=30
MEMORY_SUMMARY_TTL_DAYS=7
MEMORY_SUMMARY_MAX_TURNS=3
MEMORY_MAX_ITEMS=12
FEEDBACK_DB_PATH=output/feedback/feedback.sqlite3

# Local observability. OTLP can point to a local OpenTelemetry Collector.
JSON_LOGS=false
OTEL_ENABLED=false
OTEL_SERVICE_NAME=azure-rag-knowledge-bot-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Local authentication simulation. Keep disabled for the current anonymous PoC.
# Set AUTH_MODE=local_jwt and replace the secret with at least 32 random characters.
AUTH_MODE=disabled
LOCAL_JWT_SECRET=replace-with-at-least-32-random-characters
LOCAL_JWT_ISSUER=azure-rag-local
LOCAL_JWT_AUDIENCE=azure-rag-api

# Azure OpenAI (required only when RAG_MODE=azure)
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Azure AI Search (required only when RAG_MODE=azure)
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your-azure-search-admin-key
AZURE_SEARCH_INDEX_NAME=knowledge-index

# App
APP_ENV=local
LOG_LEVEL=INFO
TOP_K=5
MAX_CHUNKS=5
LOCAL_MIN_SCORE=0.06
AZURE_MIN_SCORE=0.01
